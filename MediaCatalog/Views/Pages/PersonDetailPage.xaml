<Page x:Class="MediaCatalog.Views.Pages.PersonDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                     Foreground="#e94560" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32,40,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Photo + bio facts -->
                <StackPanel Grid.Column="0">
                    <Border CornerRadius="10" ClipToBounds="True"
                            Height="280" Margin="0,0,0,20">
                        <Grid>
                            <Rectangle Fill="#16213e"/>
                            <TextBlock Text="👤" FontSize="60" Foreground="#0f3460"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{Binding PhotoPath}"
                                                 CreateOptions="DelayCreation"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Border>

                    <Border Background="#16213e" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding Birthday,
                                            Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="BORN" Foreground="#6c757d" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Birthday}" Foreground="White" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PlaceOfBirth,
                                            Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="BIRTHPLACE" Foreground="#6c757d" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding PlaceOfBirth}" Foreground="White"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Main content -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" Foreground="White"
                               FontSize="32" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Biography -->
                    <StackPanel Margin="0,0,0,32"
                                Visibility="{Binding Biography,
                                    Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="Biography" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Biography}" Foreground="#adb5bd"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>

                    <!-- Movies -->
                    <StackPanel Margin="0,0,0,32"
                                Visibility="{Binding MovieCredits.Count,
                                    Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="Movies in Your Library" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MovieCredits}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="120" Margin="0,0,12,0"
                                                Background="#16213e" CornerRadius="8"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.OpenCreditCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <Border CornerRadius="8,8,0,0" Height="160" ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#0f3460"/>
                                                        <Image Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <BitmapImage UriSource="{Binding PosterPath}"
                                                                    CreateOptions="DelayCreation"/>
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <Border Padding="8,6,8,8"><StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Role}"
                                                               Foreground="#6c757d" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding YearDisplay}"
                                                               Foreground="#6c757d" FontSize="10"/>
                                                </StackPanel></Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- TV Shows -->
                    <StackPanel Visibility="{Binding ShowCredits.Count,
                                    Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="TV Shows in Your Library" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ShowCredits}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="120" Margin="0,0,12,0"
                                                Background="#16213e" CornerRadius="8"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.OpenCreditCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <Border CornerRadius="8,8,0,0" Height="160" ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#0f3460"/>
                                                        <Image Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <BitmapImage UriSource="{Binding PosterPath}"
                                                                    CreateOptions="DelayCreation"/>
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <Border Padding="8,6,8,8"><StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Role}"
                                                               Foreground="#6c757d" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding YearDisplay}"
                                                               Foreground="#6c757d" FontSize="10"/>
                                                </StackPanel></Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>