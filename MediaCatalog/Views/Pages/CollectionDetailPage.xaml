<Page x:Class="MediaCatalog.Views.Pages.CollectionDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                     Foreground="#e94560" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,40">

                <!-- Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Foreground="White"
                                   FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Overview}" Foreground="#adb5bd"
                                   FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Overview,
                                       Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>

                    <!-- Edit/Delete for user collections -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding IsUserCreated,
                                    Converter={StaticResource BoolToVisibility}}">
                        <Button Content="✏ Edit" Background="#0f3460" Foreground="White"
                                BorderThickness="0" Padding="12,8" Cursor="Hand"
                                FontSize="13" Margin="0,0,8,0"
                                Command="{Binding StartEditCommand}"
                                Visibility="{Binding IsEditing,
                                    Converter={StaticResource InverseBoolToVisibility}}"/>
                        <Button Content="🗑 Delete" Background="Transparent"
                                Foreground="#e94560" BorderThickness="1"
                                BorderBrush="#e94560" Padding="12,8" Cursor="Hand"
                                FontSize="13"
                                Command="{Binding DeleteCollectionCommand}"
                                Visibility="{Binding IsEditing,
                                    Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <!-- Inline edit -->
                <Border Background="#16213e" CornerRadius="8" Padding="16"
                        Margin="0,0,0,24"
                        Visibility="{Binding IsEditing,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Collection Name" Foreground="#adb5bd"
                                   FontSize="12" Margin="0,0,0,6"/>
                        <TextBox Background="#1a1a2e" Foreground="White"
                                 BorderBrush="#0f3460" BorderThickness="1"
                                 Padding="10,8" FontSize="13" CaretBrush="White"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <Button Content="Cancel" Background="Transparent"
                                    BorderThickness="0" Foreground="#adb5bd"
                                    Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                    Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save" Background="#1a73e8"
                                    BorderThickness="0" Foreground="White"
                                    Padding="14,8" Cursor="Hand" FontWeight="SemiBold"
                                    Command="{Binding SaveEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Movie count -->
                <TextBlock Foreground="#6c757d" FontSize="13" Margin="0,0,0,16">
                    <Run Text="{Binding Movies.Count}"/>
                    <Run Text=" movie{s}"/>
                </TextBlock>

                <!-- Movies grid -->
                <ItemsControl ItemsSource="{Binding Movies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Margin="0,0,16,16"
                                    Background="#16213e" CornerRadius="8" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                        Command="{Binding DataContext.OpenMovieCommand,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <Border CornerRadius="8,8,0,0" Height="230" ClipToBounds="True">
                                        <Grid>
                                            <Rectangle Fill="#0f3460"/>
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{Binding PosterPath}"
                                                        CreateOptions="DelayCreation"/>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Border Padding="10,8,10,10"><StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="White"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" MaxHeight="38"/>
                                        <TextBlock Text="{Binding YearDisplay}"
                                                   Foreground="#6c757d" FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>