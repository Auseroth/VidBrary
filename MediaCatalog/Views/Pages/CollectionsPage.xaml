<Page x:Class="VidBrary.Views.Pages.CollectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Collections"
                       Foreground="White" FontSize="28" FontWeight="Bold"/>

            <!-- Search -->
            <Border Grid.Column="1" Background="#16213e"
                    BorderBrush="#0f3460" BorderThickness="1"
                    CornerRadius="6" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" Foreground="#6c757d"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Background="Transparent" Foreground="White"
                             BorderThickness="0" FontSize="13" Width="180"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             CaretBrush="White"/>
                    <Button Content="✕" Background="Transparent" BorderThickness="0"
                            Foreground="#6c757d" Cursor="Hand" Padding="4,0"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText,
                                Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- New collection button -->
            <Button Grid.Column="3" Content="+ New Collection"
                    Background="#7c3aed" Foreground="White"
                    BorderThickness="0" Padding="14,8"
                    FontSize="13" Cursor="Hand"
                    Command="{Binding OpenCreateDialogCommand}"/>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Margin="32,12,32,0"
                Background="#16213e" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Source" Foreground="#6c757d" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Background="#16213e" Foreground="White"
                          BorderBrush="#0f3460" Padding="10,6" FontSize="13"
                          ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SelectedSource}"/>
                <TextBlock Foreground="#6c757d" FontSize="12"
                           VerticalAlignment="Center" Margin="24,0,0,0">
                    <Run Text="{Binding FilteredCount}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" collections"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Collections}" Margin="32,16,32,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Margin="0,0,16,16"
                                Background="#16213e" CornerRadius="10"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.OpenCollectionCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border CornerRadius="10,10,0,0" Height="260" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle Fill="#0f3460"/>
                                        <TextBlock Text="🗂" FontSize="48" Foreground="#16213e"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{Binding PosterPath}"
                                                    CreateOptions="DelayCreation"/>
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>
                                <Border Padding="12,10,12,12"><StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{Binding SourceColor}"
                                                CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="White" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding MovieCountDisplay}"
                                                   Foreground="#6c757d" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel></Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Collections.Count,
                        Converter={StaticResource ZeroToVisibility}}">
            <TextBlock Text="🗂" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="No collections yet" Foreground="White"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,8"/>
            <TextBlock Text="Collections appear after scanning with a TMDB API key, or create your own."
                       Foreground="#6c757d" FontSize="14" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
        </StackPanel>

        <!-- Create dialog -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding ShowCreateDialog, Converter={StaticResource BoolToVisibility}}"
              Background="#AA000000" Panel.ZIndex="10">
            <Border Background="#16213e" CornerRadius="12" Width="420"
                    Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="New Collection" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Collection Name" Foreground="#adb5bd"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Background="#1a1a2e" Foreground="White"
                             BorderBrush="#0f3460" BorderThickness="1"
                             Padding="10,8" FontSize="13" CaretBrush="White"
                             Text="{Binding NewCollectionName,
                                 UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return"
                                Command="{Binding CreateCollectionCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding CreateError}" Foreground="#e94560"
                               FontSize="12" Margin="0,6,0,0"
                               Visibility="{Binding CreateError,
                                   Converter={StaticResource StringToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancel" Background="Transparent"
                                BorderThickness="0" Foreground="#adb5bd"
                                Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                Command="{Binding CloseCreateDialogCommand}"/>
                        <Button Content="Create" Background="#7c3aed"
                                BorderThickness="0" Foreground="White"
                                Padding="14,8" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding CreateCollectionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>