<Page x:Class="VidBrary.Views.Pages.MovieDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Page.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6c757d"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ══ Busy overlay ══ -->
        <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                     Foreground="#e94560" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="340"/>
                    <!-- Hero backdrop -->
                    <RowDefinition Height="Auto"/>
                    <!-- Content -->
                </Grid.RowDefinitions>

                <!-- ══ Hero backdrop ══ -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Image Stretch="UniformToFill" Opacity="0.35"
                           Source="{Binding BackdropPath}"/>
                    <!-- Gradient fade to page bg -->
                    <Rectangle VerticalAlignment="Bottom" Height="180">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1a1a2e" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ══ Main content ══ -->
                <Grid Grid.Row="1" Margin="40,0,40,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="32"/>
                        <!-- Gutter -->
                        <ColumnDefinition Width="*"/>
                        <!-- Main info -->
                        <ColumnDefinition Width="32"/>
                        <!-- Gutter -->
                        <ColumnDefinition Width="220"/>
                        <!-- Side panel -->
                    </Grid.ColumnDefinitions>

                    <!-- ── Poster ── -->
                    <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                            Height="300" VerticalAlignment="Top" Margin="0,-120,0,0">
                        <Grid>
                            <Rectangle Fill="#16213e"/>
                            <TextBlock Text="🎬" FontSize="48" Foreground="#0f3460"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Stretch="UniformToFill" Source="{Binding PosterPath}"/>
                        </Grid>
                    </Border>

                    <!-- ── Title & Actions ── -->
                    <StackPanel Grid.Column="2" Margin="0,-60,0,0">

                        <!-- Title row -->
                        <TextBlock Text="{Binding Title}" Foreground="White"
                                   FontSize="32" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <!-- Original title -->
                        <TextBlock Foreground="#6c757d" FontSize="14" Margin="0,0,0,8"
                                   Visibility="{Binding OriginalTitle, Converter={StaticResource StringToVisibility}}">
                            <Run Text="Original: "/>
                            <Run Text="{Binding OriginalTitle}"/>
                        </TextBlock>

                        <!-- Metadata pills row -->
                        <WrapPanel Margin="0,0,0,12">
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Year}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding Certification, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding Certification}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding RuntimeDisplay, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding RuntimeDisplay}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                            <Border Background="#f59e0b" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding RatingDisplay, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding RatingDisplay}" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding OriginalLanguage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding OriginalLanguage}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                        </WrapPanel>

                        <!-- Genres -->
                        <TextBlock Text="{Binding Genres}" Foreground="#adb5bd"
                                   FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Tags (above action buttons) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tags" Foreground="#e94560"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+" Background="Transparent" BorderThickness="0"
                                    Foreground="#adb5bd" Cursor="Hand" Padding="8,0"
                                    Command="{Binding ToggleTagPickerCommand}" FontSize="16"/>
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChip}" Background="{Binding Color}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconKey}" FontSize="12" Margin="0,0,4,0"
                                                           Visibility="{Binding IconKey, Converter={StaticResource StringToVisibility}}"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <Border Background="#16213e" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding ShowTagPicker, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding AvailableTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}"
                                                    Background="{Binding Color}" Opacity="0.7">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                        Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconKey}" FontSize="12" Margin="0,0,4,0"
                                                               Visibility="{Binding IconKey, Converter={StaticResource StringToVisibility}}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Border>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">

                            <!-- Play -->
                            <Button Style="{StaticResource DetailButton}"
                                    Background="#e94560" Content="▶  Play Now"
                                    Command="{Binding PlayCommand}"
                                    Margin="0,0,12,0"/>

                            <Button Style="{StaticResource DetailButton}"
                                    Background="#0f3460"
                                    Content="{Binding MyListButtonLabel}"
                                    Command="{Binding AddToMyListCommand}"
                                    Margin="0,0,12,0"/>

                            <!-- Match status button -->
                            <Button Style="{StaticResource DetailButton}"
                                    Background="{Binding MatchButtonColor}"
                                    Content="{Binding MatchButtonLabel}"
                                    Command="{Binding OpenMatchDialogCommand}"
                                    IsEnabled="{Binding MatchButtonEnabled}"/>
                        </StackPanel>

                        <!-- Overview -->
                        <TextBlock Text="Overview" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Overview}" Foreground="#adb5bd"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="22"
                                   Margin="0,0,0,24"/>

                        <!-- Directors / Writers -->
                        <StackPanel Visibility="{Binding Directors, Converter={StaticResource StringToVisibility}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="DIRECTED BY" Style="{StaticResource MetaLabel}"/>
                            <TextBlock Text="{Binding Directors}" Style="{StaticResource MetaValue}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Writers, Converter={StaticResource StringToVisibility}}"
                                    Margin="0,0,0,24">
                            <TextBlock Text="WRITTEN BY" Style="{StaticResource MetaLabel}"/>
                            <TextBlock Text="{Binding Writers}" Style="{StaticResource MetaValue}"/>
                        </StackPanel>

                        <!-- Cast -->
                        <TextBlock Text="Cast" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Visibility="{Binding Cast.Count, Converter={StaticResource NonZeroToVisibility}}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,24">
                            <ItemsControl ItemsSource="{Binding Cast}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="90" Margin="0,0,12,0"
                                                Background="#16213e" CornerRadius="8">
                                            <StackPanel>
                                                <Border CornerRadius="8,8,0,0" Height="110" ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#0f3460"/>
                                                        <TextBlock Text="👤" FontSize="28"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#16213e"/>
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding PhotoPath}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Padding="6,6,6,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="White" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" MaxHeight="32"/>
                                                        <TextBlock Text="{Binding Character}"
                                                                   Foreground="#6c757d" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>

                    <!-- ── Side panel ── -->
                    <StackPanel Grid.Column="4" Margin="0,24,0,0">

                        <!-- Collection -->
                        <StackPanel Margin="0,0,0,24"
                                    Visibility="{Binding CollectionName, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="COLLECTION" Style="{StaticResource MetaLabel}"/>
                            <Border Background="#0f3460" CornerRadius="6" Padding="10,8" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCollectionCommand}"/>
                                </Border.InputBindings>
                                <TextBlock Text="{Binding CollectionName}" Foreground="White"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- Technical info -->
                        <TextBlock Text="FILE INFO" Style="{StaticResource MetaLabel}"/>
                        <Border Background="#16213e" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SIZE" Style="{StaticResource MetaLabel}"/>
                                <TextBlock Text="{Binding FileSize}" Style="{StaticResource MetaValue}"/>
                                <TextBlock Text="VIDEO" Style="{StaticResource MetaLabel}"
                                           Visibility="{Binding VideoResolution, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Style="{StaticResource MetaValue}"
                                           Visibility="{Binding VideoResolution, Converter={StaticResource StringToVisibility}}">
                                    <Run Text="{Binding VideoResolution}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding VideoCodec}"/>
                                </TextBlock>
                                <TextBlock Text="AUDIO" Style="{StaticResource MetaLabel}"
                                           Visibility="{Binding AudioCodec, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Style="{StaticResource MetaValue}"
                                           Visibility="{Binding AudioCodec, Converter={StaticResource StringToVisibility}}">
                                    <Run Text="{Binding AudioCodec}"/>
                                </TextBlock>
                                <TextBlock Text="AUDIO TRACKS" Style="{StaticResource MetaLabel}"
                                           Visibility="{Binding AudioTracks, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Text="{Binding AudioTracks}" Style="{StaticResource MetaValue}"
                                           Visibility="{Binding AudioTracks, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Text="SUBTITLES" Style="{StaticResource MetaLabel}"
                                           Visibility="{Binding SubtitleTracks, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Text="{Binding SubtitleTracks}" Style="{StaticResource MetaValue}"
                                           Visibility="{Binding SubtitleTracks, Converter={StaticResource StringToVisibility}}"/>
                                <TextBlock Text="PATH" Style="{StaticResource MetaLabel}"/>
                                <TextBlock Text="{Binding FilePath}" Foreground="#6c757d"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ══ Match Dialog ══ -->
        <Grid Visibility="{Binding ShowMatchDialog, Converter={StaticResource BoolToVisibility}}"
              Background="#AA000000" Panel.ZIndex="20">
            <Border Background="#16213e" CornerRadius="12" Width="560" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0f3460" CornerRadius="12,12,0,0" Padding="20,16">
                        <Grid>
                            <TextBlock Text="Select TMDB Match" Foreground="White"
                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#adb5bd" Cursor="Hand" FontSize="16"
                                    Command="{Binding CloseMatchDialogCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="8" Cursor="Hand" Padding="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1a1a2e"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#0f3460"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding DataContext.ToggleCandidateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <Border Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="18" Height="18"
                                                            CornerRadius="9" Margin="0,0,12,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0f3460"/>
                                                                <Setter Property="BorderBrush" Value="#0f3460"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#1a73e8"/>
                                                                        <Setter Property="BorderBrush" Value="#1a73e8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="White"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding YearDisplay}" Foreground="#6c757d" FontSize="12"/>
                                                            <TextBlock Text=" · " Foreground="#6c757d" FontSize="12"/>
                                                            <TextBlock Text="{Binding RatingDisplay}" Foreground="#f59e0b" FontSize="12"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding IsExpanded, Converter={StaticResource BoolToChevron}}"
                                                               Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="42,0,12,12"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Height="120" ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#0f3460"/>
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding PosterPath}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Overview}"
                                                           Foreground="#adb5bd" FontSize="12"
                                                           TextWrapping="Wrap" MaxHeight="120"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#0d0d1a" CornerRadius="0,0,12,12" Padding="20,14">
                        <Grid>
                            <Button Content="Clear Match" HorizontalAlignment="Left"
                                    Background="Transparent" BorderThickness="1"
                                    BorderBrush="#6c757d" Foreground="#adb5bd"
                                    Padding="14,8" Cursor="Hand"
                                    Command="{Binding SaveMatchCommand}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Background="Transparent"
                                        BorderThickness="0" Foreground="#adb5bd"
                                        Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                        Command="{Binding CloseMatchDialogCommand}"/>
                                <Button Content="Save Match" Background="#1a73e8"
                                        BorderThickness="0" Foreground="White"
                                        Padding="14,8" Cursor="Hand" FontWeight="SemiBold"
                                        Command="{Binding SaveMatchCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>