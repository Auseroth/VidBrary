<Page x:Class="VidBrary.Views.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,28,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profiles"
                       Foreground="White" FontSize="28" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="+ New Profile"
                    Background="#D9652B" Foreground="White"
                    BorderThickness="0" Padding="14,8"
                    FontSize="13" Cursor="Hand"
                    Command="{Binding OpenCreateDialogCommand}"/>
        </Grid>

        <!-- Profile cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Profiles}" Margin="32,0,32,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Margin="0,0,16,16"
                                CornerRadius="10" Padding="20" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#16213e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#0f3460"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.SwitchProfileCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Ellipse Width="56" Height="56" Fill="#D9652B"
                                         HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Name}" Foreground="White"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CreatedAt}"
                                           Foreground="#6c757d" FontSize="12" Margin="0,4,0,0"/>
                                <!-- Active badge -->
                                <Border Background="#1a73e8" CornerRadius="4"
                                        Padding="8,3" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsActive,
                                            Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Active" Foreground="White" FontSize="11"/>
                                </Border>
                                <!-- Delete (only non-active profiles) -->
                                <Button Content="Remove" Background="Transparent"
                                        Foreground="#D9652B" BorderThickness="0"
                                        Padding="0" Cursor="Hand" FontSize="12"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding DataContext.DeleteProfileCommand,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsActive,
                                            Converter={StaticResource InverseBoolToVisibility}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Create dialog -->
        <Grid Grid.RowSpan="2"
              Visibility="{Binding ShowCreateDialog, Converter={StaticResource BoolToVisibility}}"
              Background="#AA000000" Panel.ZIndex="10">
            <Border Background="#16213e" CornerRadius="12" Width="380"
                    Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="New Profile" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Profile Name" Foreground="#adb5bd"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Background="#1a1a2e" Foreground="White"
                             BorderBrush="#0f3460" BorderThickness="1"
                             Padding="10,8" FontSize="13" CaretBrush="White"
                             Text="{Binding NewProfileName,
                                 UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CreateProfileCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding CreateError}" Foreground="#D9652B"
                               FontSize="12" Margin="0,6,0,0"
                               Visibility="{Binding CreateError,
                                   Converter={StaticResource StringToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancel" Background="Transparent"
                                BorderThickness="0" Foreground="#adb5bd"
                                Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                Command="{Binding CloseCreateDialogCommand}"/>
                        <Button Content="Create" Background="#D9652B"
                                BorderThickness="0" Foreground="White"
                                Padding="14,8" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding CreateProfileCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>