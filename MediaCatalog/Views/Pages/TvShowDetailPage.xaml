<Page x:Class="VidBrary.Views.Pages.TvShowDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Page.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6c757d"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                     Foreground="#e94560" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="340"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══ Hero ══ -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Image Stretch="UniformToFill" Opacity="0.35"
                           Source="{Binding BackdropPath}"/>
                    <Rectangle VerticalAlignment="Bottom" Height="180">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1a1a2e" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ══ Content ══ -->
                <Grid Grid.Row="1" Margin="40,0,40,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster -->
                    <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                            Height="300" VerticalAlignment="Top" Margin="0,-120,0,0">
                        <Grid>
                            <Rectangle Fill="#16213e"/>
                            <TextBlock Text="📺" FontSize="48" Foreground="#0f3460"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Stretch="UniformToFill" Source="{Binding PosterPath}"/>
                        </Grid>
                    </Border>

                    <!-- Main info -->
                    <StackPanel Grid.Column="2" Margin="0,-60,0,0">

                        <TextBlock Text="{Binding Title}" Foreground="White"
                                   FontSize="32" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <!-- Pills -->
                        <WrapPanel Margin="0,0,0,12">
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding YearRange}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding Status}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                            <Border Background="#f59e0b" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding RatingDisplay, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding RatingDisplay}" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#16213e" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding OriginalLanguage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding OriginalLanguage}" Foreground="#adb5bd" FontSize="13"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding Genres}" Foreground="#adb5bd"
                                   FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Tags (above action buttons) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tags" Foreground="#e94560"
                FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+" Background="Transparent" BorderThickness="0"
             Foreground="#adb5bd" Cursor="Hand" Padding="8,0"
             Command="{Binding ToggleTagPickerCommand}" FontSize="16"/>
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChip}" Background="{Binding Color}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconKey}" FontSize="12" Margin="0,0,4,0"
                                    Visibility="{Binding IconKey, Converter={StaticResource StringToVisibility}}"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <Border Background="#16213e" CornerRadius="8" Padding="12" Margin="0,0,0,16"
         Visibility="{Binding ShowTagPicker, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding AvailableTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}"
                             Background="{Binding Color}" Opacity="0.7">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                 Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconKey}" FontSize="12" Margin="0,0,4,0"
                                        Visibility="{Binding IconKey, Converter={StaticResource StringToVisibility}}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Style="{StaticResource DetailButton}"
                                    Background="{Binding MatchButtonColor}"
                                    Content="{Binding MatchButtonLabel}"
                                    Command="{Binding OpenMatchDialogCommand}"
                                    IsEnabled="{Binding MatchButtonEnabled}"/>
                            <Button Style="{StaticResource DetailButton}"
                                    Background="#0f3460" Content="＋ My List"
                                    Command="{Binding AddToMyListCommand}"
                                    Margin="0,0,12,0"/>
                        </StackPanel>

                        <!-- Overview -->
                        <TextBlock Text="Overview" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Overview}" Foreground="#adb5bd"
                                   FontSize="14" TextWrapping="Wrap" LineHeight="22"
                                   Margin="0,0,0,24"/>

                        <!-- Cast -->
                        <TextBlock Text="Cast" Foreground="#e94560"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Visibility="{Binding Cast.Count, Converter={StaticResource NonZeroToVisibility}}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,24">
                            <ItemsControl ItemsSource="{Binding Cast}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="90" Margin="0,0,12,0"
                                                Background="#16213e" CornerRadius="8">
                                            <StackPanel>
                                                <Border CornerRadius="8,8,0,0" Height="110" ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#0f3460"/>
                                                        <TextBlock Text="👤" FontSize="28"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#16213e"/>
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding PhotoPath}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Padding="6,6,6,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" MaxHeight="32"/>
                                                        <TextBlock Text="{Binding Character}"
                                                                   Foreground="#6c757d" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                       

                        <!-- ══ Seasons header + order picker ══ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Seasons" Foreground="#e94560"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Order:" Foreground="#6c757d" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding OrderModeOptions}"
                                          SelectedItem="{Binding SelectedOrderMode, Mode=TwoWay}"
                                          MinWidth="160" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══ Seasons accordion ══ -->
                        <ItemsControl ItemsSource="{Binding Seasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16213e" CornerRadius="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Border Padding="16,12" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                        Command="{Binding DataContext.ToggleSeasonCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding AirYear}" Foreground="#6c757d"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding EpisodeCountDisplay}"
                                                               Foreground="#6c757d" FontSize="13"
                                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding IsExpanded, Converter={StaticResource BoolToChevron}}"
                                                               Foreground="#6c757d" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Episodes}"
                                                          Margin="0,0,0,8"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="16,0,16,2" Background="#1a1a2e" CornerRadius="6">
                                                            <StackPanel>
                                                                <!-- Episode row -->
                                                                <Border Padding="12,10" Cursor="Hand">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                            Command="{Binding DataContext.ToggleEpisodeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    </Border.InputBindings>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                            <ColumnDefinition Width="60"/>
                                                                            <ColumnDefinition Width="36"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding EpisodeLabel}"
                                                                                   Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding TitleDisplay}"
                                                                                   Foreground="White" FontSize="13"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding RuntimeDisplay}"
                                                                                   Foreground="#6c757d" FontSize="12"
                                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding RatingDisplay}"
                                                                                   Foreground="#f59e0b" FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                                        <Button Grid.Column="4" Content="▶"
                                                                                Background="#e94560" Foreground="White"
                                                                                BorderThickness="0" Padding="6,4"
                                                                                FontSize="11" Cursor="Hand"
                                                                                Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- Right sidebar -->
                    <StackPanel Grid.Column="4" Margin="0,24,0,0">
                        <TextBlock Text="Show Info" Style="{StaticResource MetaLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="Seasons" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding TotalSeasons}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Episodes" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding TotalEpisodes}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Language" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding OriginalLanguage}" Style="{StaticResource MetaValue}"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>