<Page x:Class="MediaCatalog.Views.Pages.TagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,28,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tag Manager" Foreground="White"
                           FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Create tags to organize and filter your library."
                           Foreground="#6c757d" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Tag"
                    Background="#e94560" Foreground="White"
                    BorderThickness="0" Padding="14,8"
                    FontSize="13" Cursor="Hand"
                    Command="{Binding OpenCreateDialogCommand}"/>
        </Grid>

        <!-- Tag list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">

                <ProgressBar Height="2" IsIndeterminate="True"
                             Foreground="#e94560" Background="Transparent"
                             BorderThickness="0" Margin="0,0,0,16"
                             Visibility="{Binding IsBusy,
                                 Converter={StaticResource BoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16213e" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Color + icon swatch -->
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            CornerRadius="18" Margin="0,0,14,0"
                                            Background="{Binding Color}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconKey}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="White" FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <!-- Delete -->
                                    <Button Grid.Column="2" Content="🗑"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#6c757d" Cursor="Hand"
                                            FontSize="16" Padding="8,0"
                                            Command="{Binding DataContext.DeleteTagCommand,
                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding Tags.Count,
                                Converter={StaticResource ZeroToVisibility}}"
                            Margin="0,60,0,0">
                    <TextBlock Text="🏷" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="No tags yet" Foreground="White"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="Create tags to label movies and shows in your library."
                               Foreground="#6c757d" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Create dialog -->
        <Grid Grid.RowSpan="2"
              Visibility="{Binding ShowCreateDialog,
                  Converter={StaticResource BoolToVisibility}}"
              Background="#AA000000" Panel.ZIndex="10">
            <Border Background="#16213e" CornerRadius="12" Width="460"
                    Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="New Tag" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Name -->
                    <TextBlock Text="Tag Name" Foreground="#adb5bd"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Background="#1a1a2e" Foreground="White"
                             BorderBrush="#0f3460" BorderThickness="1"
                             Padding="10,8" FontSize="13" CaretBrush="White"
                             Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Color picker -->
                    <TextBlock Text="Color" Foreground="#adb5bd"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Margin="0,0,8,8" Cursor="Hand"
                                        Background="{Binding}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectColorCommand,
                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Icon picker -->
                    <TextBlock Text="Icon (optional)" Foreground="#adb5bd"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding PresetIcons}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,0,6,6"
                                        CornerRadius="6" Cursor="Hand"
                                        Background="#1a1a2e">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectIconCommand,
                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding}" FontSize="18"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Preview -->
                    <Border CornerRadius="20" Padding="12,6"
                            HorizontalAlignment="Left" Margin="0,0,0,16"
                            Background="{Binding NewTagColor}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NewTagIcon}" FontSize="14"
                                       Margin="0,0,6,0"
                                       Visibility="{Binding NewTagIcon,
                                           Converter={StaticResource StringToVisibility}}"/>
                            <TextBlock Foreground="White" FontSize="13">
                                <Run Text="{Binding NewTagName, FallbackValue='Tag Preview'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CreateError}" Foreground="#e94560"
                               FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding CreateError,
                                   Converter={StaticResource StringToVisibility}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Background="Transparent"
                                BorderThickness="0" Foreground="#adb5bd"
                                Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                Command="{Binding CloseCreateDialogCommand}"/>
                        <Button Content="Create Tag" Background="#e94560"
                                BorderThickness="0" Foreground="White"
                                Padding="14,8" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding CreateTagCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>