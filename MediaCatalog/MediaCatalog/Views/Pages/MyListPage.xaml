<Page x:Class="VidBrary.Views.Pages.MyListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <TextBlock Grid.Row="0" Text="My List"
                   Foreground="White" FontSize="28" FontWeight="Bold"
                   Margin="32,28,32,16"/>

        <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom"
                     IsIndeterminate="True" Foreground="#e94560"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

        <!-- ══ List ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="32,0,32,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" CornerRadius="8"
                                Background="#16213e" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Poster thumbnail -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle Fill="#0f3460"/>
                                        <Image Stretch="UniformToFill" Source="{Binding PosterPath}"/>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="#6c757d" FontSize="12"/>
                                        <TextBlock Text=" · Added " Foreground="#6c757d" FontSize="12"/>
                                        <TextBlock Text="{Binding AddedDisplay}"
                                                   Foreground="#6c757d" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Remove button -->
                                <Button Grid.Column="2"
                                        Content="✕"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#6c757d" FontSize="16"
                                        Cursor="Hand" Padding="16,0"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ Empty state ══ -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibility}}">
            <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="Your list is empty" Foreground="White"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,8"/>
            <TextBlock Foreground="#6c757d" FontSize="14" HorizontalAlignment="Center"
                       Text="Add movies and TV shows to your list from their detail pages."/>
        </StackPanel>

    </Grid>
</Page>