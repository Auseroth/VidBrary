<Window x:Class="VidBrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VidBrary" Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBrushBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Custom title bar ══ -->
        <Border Grid.Row="0" Background="#0d0d1a">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0" IsHitTestVisible="False">
                    <Image Source="/Resources/libDiscPlay3 (2).ico"
                           Width="30" Height="30" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="VidBrary"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="46" Height="40"
                            Background="Transparent" Foreground="#adb5bd"
                            BorderThickness="0" FontSize="14"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>
                    <Button Content="□" Width="46" Height="40"
                            Background="Transparent" Foreground="#adb5bd"
                            BorderThickness="0" FontSize="14"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕" Width="46" Height="40"
                            Background="Transparent" Foreground="#adb5bd"
                            BorderThickness="0" FontSize="14"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            x:Name="CloseButton"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#adb5bd"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D9652B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Main content ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══ -->
            <Border Grid.Column="0" Background="#16213e" Padding="0,16,0,16">
                <DockPanel>

                    <!-- Top: app name + profile card -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,0,16,20">
                        <TextBlock Text="🎬 VidBrary" Foreground="White"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Border Background="#0f3460" CornerRadius="6" Padding="8,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding MainViewModel.NavigateProfilesCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="28" Height="28" Fill="#D9652B" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfilesViewModel.ActiveProfile.Name,
                                                   FallbackValue='Default'}"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Switch profile →"
                                               Foreground="#6c757d" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom: back + settings -->
                    <Button DockPanel.Dock="Bottom"
                            Content="⚙  Settings"
                            Command="{Binding MainViewModel.NavigateSettingsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="8,0,8,4"/>
                    <Button DockPanel.Dock="Bottom"
                            Content="← Back"
                            Command="{Binding MainViewModel.GoBackCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="8,0,8,4"
                            Visibility="{Binding MainViewModel.CanGoBack,
                                Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Nav buttons -->
                    <StackPanel Margin="8,0">
                        <Button Content="🏠  Home"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateHomeCommand}"/>
                        <Button Content="🎬  Movies"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateMoviesCommand}"/>
                        <Button Content="📺  TV Shows"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateTvShowsCommand}"/>
                        <Button Content="📋  My List"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateMyListCommand}"/>
                        <Button Content="🗂  Collections"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateCollectionsCommand}"/>
                        <Button Content="👤  People"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigatePeopleCommand}"/>
                        <Button Content="🏷  Tags"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding MainViewModel.NavigateTagsCommand}"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ═══ Page frame ═══ -->
            <Frame x:Name="MainFrame" Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="#1a1a2e"/>
        </Grid>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="2" Background="#0d0d1a" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ScanViewModel.ScanStatus}"
                           Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ProgressBar Width="120" Height="4" Margin="0,0,12,0"
                                 IsIndeterminate="True" Foreground="#D9652B"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding ScanViewModel.IsScanning,
                                     Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ScanViewModel.LastScanSummary}"
                               Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
