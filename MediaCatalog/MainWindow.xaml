<Window x:Class="MediaCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaCatalog" Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══ -->
            <Border Grid.Column="0" Background="#16213e" Padding="0,16,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,0,16,20">
                        <TextBlock Text="🎬 MediaCatalog" Foreground="White"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Border Background="#0f3460" CornerRadius="6" Padding="8,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding MainViewModel.NavigateProfilesCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="28" Height="28" Fill="#e94560" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfilesViewModel.ActiveProfile.Name,
                                                   FallbackValue='Default'}"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Switch profile →"
                                               Foreground="#6c757d" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Content="⚙  Settings"
                            Command="{Binding MainViewModel.NavigateSettingsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="8,0,8,4"/>

                    <Button DockPanel.Dock="Bottom"
                            Content="← Back"
                            Command="{Binding MainViewModel.GoBackCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="8,0,8,4"
                            Visibility="{Binding MainViewModel.CanGoBack,
                                Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel Margin="8,0">
                        <Button Content="🏠  Home"        Command="{Binding MainViewModel.NavigateHomeCommand}"        Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="🎬  Movies"      Command="{Binding MainViewModel.NavigateMoviesCommand}"      Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="📺  TV Shows"    Command="{Binding MainViewModel.NavigateTvShowsCommand}"     Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="🗂  Collections" Command="{Binding MainViewModel.NavigateCollectionsCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="👤  People"      Command="{Binding MainViewModel.NavigatePeopleCommand}"      Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="🏷  Tags"        Command="{Binding MainViewModel.NavigateTagsCommand}"        Style="{StaticResource SidebarButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame x:Name="MainFrame" Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="#1a1a2e"/>
        </Grid>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="1" Background="#0d0d1a" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ScanViewModel.ScanStatus}"
                           Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ProgressBar Width="120" Height="4" Margin="0,0,12,0"
                                 IsIndeterminate="True" Foreground="#e94560"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding ScanViewModel.IsScanning,
                                     Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ScanViewModel.LastScanSummary}"
                               Foreground="#6c757d" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
